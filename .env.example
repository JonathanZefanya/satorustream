# Dipakai saat `npm run dev`.
# Jalankan superanime lebih dulu: cd ../SuperAnime && bun dev
VITE_API_BASE_URL=http://localhost:3001

# Domain publik situs, TANPA garis miring di akhir. Dipakai untuk URL kanonis,
# tag Open Graph, sitemap.xml, dan robots.txt. Salah isi di sini berarti Google
# mengindeks alamat yang keliru, jadi samakan dengan domain produksi asli.
VITE_SITE_URL=http://localhost:5173

# Sumber scraper AWAL. Pengguna (termasuk tamu) bisa menggantinya kapan saja
# lewat pemilih "Sumber" di header; pilihannya disimpan per perangkat. Nilai di
# sini hanya dipakai saat seseorang belum pernah memilih.
#
# Menu yang tidak didukung sebuah sumber otomatis disembunyikan.
#
#   otakudesu  — paling lengkap: jadwal per hari, katalog A-Z, streaming + 7 mirror
#   oploverz   — lengkap kecuali katalog A-Z; streaming lewat satu iframe
#   nimegami   — tanpa jadwal per hari, A-Z, dan daftar selesai; streaming 4 resolusi
#   kuramanime — hanya jelajah (beranda, cari, genre, detail). TIDAK bisa memutar
#                episode: URL videonya dihasilkan skrip ter-obfuscate di browser.
VITE_API_SOURCE=otakudesu

# Supabase — WAJIB untuk wishlist dan riwayat tontonan, karena keduanya terikat
# akun. Tanpa ini menjelajah dan menonton tetap berjalan penuh, hanya wishlist
# dan riwayat yang tidak tersedia.
#
# Langkah: buat project Supabase -> jalankan supabase-user-schema.sql di SQL
# Editor -> salin Project URL dan anon/publishable key ke bawah ini.
#
# Anon key memang dirancang publik dan aman terekspos di browser SELAMA RLS
# aktif. Jangan pernah menaruh service_role key atau password database di sini:
# semua variabel VITE_* ikut ter-bundle dan bisa dibaca siapa saja.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# buat .env.development dan .env.production dari .env.example, lalu isi variabelnya sesuai kebutuhan.
